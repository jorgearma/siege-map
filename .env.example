# SSH Bot Rain Map - Environment Configuration

# Path to SSH log file (common locations)
# Debian/Ubuntu: /var/log/auth.log
# RHEL/CentOS:   /var/log/secure
SSH_LOG_PATH=/var/log/auth.log
NGINX_LOG_PATH=/var/log/nginx/access.log
# Several access logs (comma separated, container paths). Overrides NGINX_LOG_PATH.
NGINX_LOG_PATHS=
# Host folder mounted read-only as /var/log/nginx inside the backend
# (e.g. the folder where a containerised site writes its logs).
# Several containerised sites: one parent folder, one subfolder per site, e.g.
#   NGINX_LOG_DIR=/var/log/web
#   NGINX_LOG_PATHS=/var/log/nginx/portfolio/access.log,/var/log/nginx/otra-web/access.log
NGINX_LOG_DIR=/var/log/nginx
# Truncate HTTP visitor IPs to /24 (IPv4) or /48 (IPv6) before storing them
MASK_HTTP_IPS=true
# GID of the host group that can read the logs ("adm" = 4 on Debian/Ubuntu: getent group adm)
LOG_GID=4
# Your own IPs, never shown on the map (comma separated)
IGNORE_IPS=

# Time zone of the HOST (timedatectl | grep "Time zone"). Classic syslog lines
# have no offset, so the container must use the host's clock or every time
# window (5m, 1h...) is shifted. Lines that do carry an offset are converted.
TZ=UTC

# Your VPS coordinates (where the "rain" falls to)
VPS_LAT=40.4168
VPS_LON=-3.7038
VPS_LABEL=My VPS

# Geolocation provider:
#   "ip-api"  free, no key, 45 req/min. Also says if the network is hosting/mobile/proxy.
#   "ipinfo"  needs a token.
#   "mmdb"    local database files: no rate limit and no IP ever leaves the server.
#             Run scripts/fetch_geoip.sh once (and monthly) to download them.
GEO_PROVIDER=ip-api
# Host folder with city.mmdb / asn.mmdb, mounted read-only at /geoip (GEO_PROVIDER=mmdb)
GEOIP_DIR=./geoip

# Only needed if GEO_PROVIDER=ipinfo
IPINFO_TOKEN=

# Backend host/port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend: published on localhost only (put a reverse proxy / Cloudflare Tunnel in front).
# BIND_ADDR=0.0.0.0 exposes it directly — Docker bypasses ufw.
BIND_ADDR=127.0.0.1
FRONTEND_PORT=8082

# Max events to keep in memory
MAX_EVENTS=10000

# Geolocation cache TTL in seconds
GEO_CACHE_TTL=86400

# WebSocket broadcast interval in seconds (aggregation window)
WS_BROADCAST_INTERVAL=1.0

# Map tiles (CARTO basemaps): https://carto.com/basemaps/apikey
# Goes into the frontend JS at build time → public. Restrict it to your domain.
# Changing it needs a rebuild: docker compose up -d --build
CARTO_API_KEY=

# Threat intelligence (Phase 3)
# AbuseIPDB: free tier = 1000 checks/day — https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# Shodan: optional host info (ports, OS, vulns) — https://www.shodan.io/
SHODAN_API_KEY=

# AbuseIPDB result cache TTL in seconds
ABUSE_CACHE_TTL=86400

# ── Persistence (SQLite, inside the "siege-data" Docker volume) ──
# Days of individual events kept for the time-lapse / flow chart.
# Daily aggregates (rankings, trends) are kept forever.
EVENT_RETENTION_DAYS=7

# ── Extra tagging ──
# Download the public Tor exit-node list once a day (one request to torproject.org)
TOR_EXIT_LIST=true
# GreyNoise community API, optional: https://viz.greynoise.io/account/api-key
# Only queried when a dossier is opened, at most GREYNOISE_DAILY_LIMIT times a day.
GREYNOISE_API_KEY=
GREYNOISE_DAILY_LIMIT=40
# Your own hostnames (comma separated): referrers from them count as "internal"
OWN_DOMAINS=
# How many usernames, tried in the same order, identify a botnet wordlist
CAMPAIGN_PREFIX_LEN=4
# Link shown on the landing screen
REPO_URL=https://github.com/jorgearma/siege-map

# ── Alerting ──
# Rules run every ALERT_INTERVAL seconds. An alert is raised once per subject,
# updated while its condition holds and resolved after ALERT_COOLDOWN seconds
# of calm; only then can the same subject alert again.
ALERTS_ENABLED=true
ALERT_INTERVAL=30
ALERT_COOLDOWN=600
# Threat score (0-100) that raises an alert for an active address
ALERT_SCORE_THRESHOLD=75
# Burst: at least this many events in 5 min AND above mean + 3σ of the last 24 h
ALERT_BURST_MIN=100
# Country surge: this many distinct SSH addresses in 10 min, 3x the country's usual
ALERT_COUNTRY_IPS=15
# One address trying this many different accounts in 10 min
ALERT_SPRAY_USERS=40
# Smallest campaign (MEDIUM/HIGH confidence) worth an alert
ALERT_CAMPAIGN_MIN_IPS=3
# "Accepted" login alerts only if that address had this many failed attempts
ALERT_LOGIN_MIN_FAILS=3
# Exploit path answered with 2xx. Turn off if a monitored site answers 200 to everything.
ALERT_EXPLOIT_2XX=true
ALERT_RETENTION_DAYS=90
# Where to send them (optional; without it alerts only show on the dashboard).
# Discord and Slack webhook URLs are detected; any other URL receives JSON.
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Least severe alert that is sent out: LOW | MEDIUM | HIGH | CRITICAL
ALERT_NOTIFY_MIN_SEVERITY=HIGH
